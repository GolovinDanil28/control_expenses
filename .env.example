# Скопируйте в .env и заполните. .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Список chat_id через запятую. Узнать свой: напишите боту, посмотрите в логе.
ALLOWED_CHAT_IDS=

# Путь к файлу SQLite
DB_PATH=data/control_expenses.db

# Таймзона пользователя (IANA)
TZ=Europe/Moscow

# Лимит на месяц по умолчанию, в копейках. 50000.00 ₽ = 5000000
MONTHLY_BUDGET_KOPECKS=5000000

# Еженедельная сводка: день недели (0=пн..6=вс) и время HH:MM
WEEKLY_REPORT_DOW=0
WEEKLY_REPORT_TIME=11:00

# Тихий час: в это время оповещения не приходят, а переносятся
QUIET_START=23:00
QUIET_END=08:00

# Разбор текста: none | ollama | openai. Без него работает детерминированный парсер.
LLM_BACKEND=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
